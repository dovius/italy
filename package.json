{
  "name": "keliones-vertejas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "npm run typecheck && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "start": "NODE_ENV=production node dist-server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.cloudflare.json",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "build:cloudflare": "npm run typecheck && vite build",
    "cf:prepare": "node scripts/prepare-cloudflare.mjs",
    "cf:dev": "npm run build:cloudflare && wrangler dev --port 8787",
    "cf:check": "npm run build:cloudflare && wrangler deploy --dry-run --outdir .cloudflare-build",
    "cf:deploy": "npm run build:cloudflare && wrangler deploy --secrets-file .dev.vars",
    "cf:tail": "wrangler tail",
    "cf:delete": "wrangler delete",
    "test:cloudflare": "tsx --test --test-timeout=20000 tests/cloudflare/*.test.ts",
    "test:e2e:cloudflare": "npm run build:cloudflare && E2E_TARGET=cloudflare playwright test"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/lora": "5.3.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "lucide-react": "1.45.0",
    "multer": "2.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "5.20260911.1",
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "miniflare": "5.20260911.0-alpha",
    "sharp": "0.35.4",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "wrangler": "4.131.1"
  }
}
