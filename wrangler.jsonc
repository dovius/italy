{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "keliones-vertejas",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "italiano.vild.lt", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/join", "/join/*", "/stats", "/stats/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "TRIP_SESSIONS", "class_name": "TripSession" },
      { "name": "ACTIVITY_LOG", "class_name": "ActivityLog" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TripSession"] },
    { "tag": "v2", "new_sqlite_classes": ["ActivityLog"] }
  ],
  "vars": {
    "OPENAI_LIVE_MODEL": "gpt-live-1",
    "OPENAI_TEXT_MODEL": "gpt-5.6-sol",
    "OPENAI_TRANSCRIBE_MODEL": "gpt-4o-mini-transcribe",
    "OPENAI_SPEECH_MODEL": "gpt-4o-mini-tts"
  },
  "observability": { "enabled": false }
}
