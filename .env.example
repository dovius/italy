# Keep this key on the server. Never use a VITE_ prefix for secrets.
OPENAI_API_KEY=
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_TEXT_MODEL=gpt-5.6-sol
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
PORT=3000
HOST=0.0.0.0
# Set to the exact HTTPS origin in production, e.g. https://kelione.example.com
APP_ORIGIN=
# Optional: number of trusted reverse-proxy hops (usually 1 behind a host proxy).
TRUST_PROXY=0
# Optional private-trip access. Generate with: openssl rand -hex 24
# Share https://your-domain/join/YOUR_TOKEN once; no login is required.
TRIP_ACCESS_TOKEN=
# Private /stats dashboard and activity recording (disabled without a password).
# Generate an independent password with: openssl rand -hex 24
STATS_ADMIN_PASSWORD=
STATS_DB_PATH=./data/stats.sqlite
STATS_RETENTION_DAYS=30
# Topic URL; optional token for an authenticated ntfy server.
NTFY_TOPIC_URL=https://ntfy.sh/dode-italiano
NTFY_TOKEN=
